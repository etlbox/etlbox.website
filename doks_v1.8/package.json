{
  "name": "etlbox",
  "version": "1.9.3",
  "description": "ETLBox Website",
  "author": "ETLBoxperts GmbH",
  "license": "MIT",
  "scripts": {
    "create": "hugo new",
    "dev": "hugo server --disableFastRender --noHTTPCache",
    "dev:ext": "set HUGO_ENV=next&& hugo server --disableFastRender --noHTTPCache",
    "dev:clone": "set HUGO_ENV=clone&& hugo server --disableFastRender --noHTTPCache",
    "dev:experts": "hugo server --environment experts --disableFastRender --noHTTPCache",
    "format": "prettier **/** -w -c",
    "build": "hugo --minify --gc",
    "build:ext": "set HUGO_ENV=next&& hugo --minify --gc",
    "build:clone": "set HUGO_ENV=clone&& hugo --minify --gc",
    "build:experts": "hugo --environment experts --minify --gc",
    "preview": "vite preview --outDir public"
  },
  "dependencies": {
    "@glidejs/glide": "^3.7.1",
    "@tabler/icons": "^3.36.1",
    "@thulite/doks-core": "^1.9.3",
    "@thulite/images": "^3.3.4",
    "@thulite/inline-svg": "^1.2.2",
    "@thulite/seo": "^2.4.3",
    "thulite": "^2.6.5",
    "tom-select": "^2.3.1"
  },
  "overrides": {
    "minimatch": "^10.2.2",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
